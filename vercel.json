{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://reviewed-keeping-montreal-yoga.trycloudflare.com/api/v1/:path*"
    },
    {
      "source": "/:slug",
      "destination": "/public-card/index.html"
    }
  ]
}
